<Page
    x:Class="WinIrcClient.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <StackPanel Spacing="12">
            <Button Content="Back" HorizontalAlignment="Left" Click="OnBackClicked" />
            <CheckBox x:Name="AutoScrollCheckBox"
                      Content="Automatically scroll to new incoming messages"
                      Checked="OnAutoScrollChanged"
                      Unchecked="OnAutoScrollChanged" />
        </StackPanel>
    </Grid>
</Page>